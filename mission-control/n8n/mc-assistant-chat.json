        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          480,
          300
        ],
        "parameters": {
          "jsCode": "\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst origin = String(headers.origin || headers.Origin || '');\nif (origin !== 'https://grabcalls.com') {\n  return [{ json: { ok: false, statusCode: 403, response: { error: 'origin' } } }];\n}\nconst body = item.body || {};\nconst message = typeof body.message === 'string' ? body.message.trim() : '';\nif (!message) {\n  return [{ json: { ok: false, statusCode: 400, response: { error: 'empty' } } }];\n}\nif (message.length > 2000) {\n  return [{ json: { ok: false, statusCode: 400, response: { error: 'too_long' } } }];\n}\nconst history = (Array.isArray(body.history) ? body.history : []).slice(-10).map((h) => ({\n  role: h && h.role === 'assistant' ? 'assistant' : 'user',\n  content: String((h && h.content) || '').slice(0, 2000)\n})).filter((h) => h.content);\nreturn [{ json: { ok: true, message, history } }];\n"
        }
      },
      {
        "id": "8f1c0a10-1111-4a1a-9c1a-000000000003",
        "name": "Allowed",
        "type": "n8n-nodes-base.if",
