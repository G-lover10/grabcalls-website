      {
        "id": "8f1c0a10-1111-4a1a-9c1a-000000000006",
        "name": "Build prompt",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
          160
        ],
        "parameters": {
          "jsCode": "\nconst check = $('Validate').first().json;\nconst raw = $input.first().json;\nconst items = Array.isArray(raw) ? raw : (raw.items || []);\nconst summary = items.map((it) => `- [${it.type}/${it.status}] ${it.title} | next: ${it.next_step || 'none'} | updated: ${it.last_updated}`).join('\\n');\nconst system = [\n  'You are the Glover Enterprise Mission Control assistant for Eric.',\n  'Answer only from the items summary and the conversation.',\n  'If it is not in the summary, say you do not have it in the items list.',\n  'Do not invent clients, revenue, or statuses.',\n  'Do not claim you edited the repo, sent email, or changed a server.',\n  'Never ask for or repeat API keys, tokens, or passwords.',\n  'BFRS is hands-off. GoHighLevel is outdated. The Grok voice agent replaced it.',\n  'The model list Fable 5, Sonnet, Laguna, Ling-1T is outdated.',\n  'Keep the reply short enough to speak: 2 to 4 sentences, then one next step if there is one.',\n  '',\n  'ITEMS:',\n  summary || '(no items loaded)'\n].join('\\n');\nconst messages = [{ role: 'system', content: system }, ...(check.history || []), { role: 'user', content: check.message }];\nreturn [{\n  json: {\n    xaiBody: {\n      model: 'grok-4.3',\n      temperature: 0.2,\n      max_tokens: 400,\n      messages\n    }\n  }\n}];\n"
        }
      },
      {
        "id": "8f1c0a10-1111-4a1a-9c1a-000000000007",
