      {
        "parameters": {
          "jsCode": "\nconst typeMap = { 'Project': 'project', 'Open item': 'task' };\nconst statusMap = { Running: 'active', Broken: 'blocked', Stale: 'outdated', Paused: 'paused', Planned: 'paused', Unknown: 'paused' };\nconst plain = (arr) => (Array.isArray(arr) ? arr.map((t) => t.plain_text || '').join('') : '');\nconst sel = (p) => (p && p.select ? p.select.name : '');\nconst raw = $input.first().json;\nconst pages = Array.isArray(raw.results) ? raw.results : [];\nconst items = pages.map((pg) => {\n  const p = pg.properties || {};\n  const boardType = sel(p['Type']);\n  const boardStatus = sel(p['Status']) || 'Unknown';\n  const venture = sel(p['Venture']);\n  const needs = !!(p['Needs Eric'] && p['Needs Eric'].checkbox);\n  const checked = p['Last checked'] && p['Last checked'].date ? p['Last checked'].date.start : '';\n  const tags = [boardType, venture, 'board: ' + boardStatus].filter(Boolean);\n  if (needs) tags.unshift('Needs Eric');\n  return {\n    id: pg.id,\n    type: typeMap[boardType] || 'app',\n    title: plain(p['Name'] && p['Name'].title) || '(untitled)',\n    status: statusMap[boardStatus] || 'paused',\n    owner: plain(p['Owner/agent'] && p['Owner/agent'].rich_text),\n    last_updated: (checked || String(pg.last_edited_time || '')).slice(0, 10),\n    next_step: plain(p['Next action'] && p['Next action'].rich_text),\n    health_note: plain(p['Health note'] && p['Health note'].rich_text),\n    session_url: pg.url || '',\n    needs_eric: needs,\n    tags\n  };\n});\nitems.sort((a, b) => Number(b.needs_eric) - Number(a.needs_eric));\nreturn [{ json: { ok: true, statusCode: 200, response: { source: 'notion-board', generated_at: new Date().toISOString(), items } } }];\n"
